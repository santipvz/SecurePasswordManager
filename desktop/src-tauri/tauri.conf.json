{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secure Password Manager",
  "version": "0.1.0",
  "identifier": "com.santipvz.securepasswordmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "create": false, "devtools": false, "title": "Secure Password Manager", "width": 1120, "height": 740, "minWidth": 375, "minHeight": 500 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "vault-session",
          "windows": ["main"],
          "permissions": [
            "allow-vault-status",
            "allow-vault-unlock",
            "allow-vault-unlock-key",
            "allow-vault-select",
            "allow-vault-list",
            "allow-vault-entry-notes",
            "allow-vault-reveal",
            "allow-vault-copy",
            "allow-vault-save",
            "allow-vault-delete",
            "allow-vault-lock",
            "allow-vault-active",
            "allow-vault-activity"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": { "resources/vault-process": "vault-process/" }
  }
}
